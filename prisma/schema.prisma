generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model TrackingEvent {
  id         String   @id @default(uuid())

  // Dedup key: Kafka is at-least-once.
  eventId    String   @unique

  shipmentId String
  reference  String
  eventType  String
  status     String
  driverId   String?
  origin     String
  destination String
  occurredAt DateTime
  recordedAt DateTime @default(now())

  @@index([shipmentId, occurredAt])
}

// Poison messages, parked so they cannot block a partition.
model DeadLetter {
  id        String   @id @default(uuid())
  eventId   String?
  topic     String
  partition Int
  offset    String
  payload   String
  error     String
  createdAt DateTime @default(now())
}
