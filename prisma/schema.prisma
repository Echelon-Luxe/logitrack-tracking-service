generator client {
  provider = "prisma-client-js"
  // Pinned, not detected. The build stage (node:24-bookworm-slim) has no
  // openssl CLI, so Prisma cannot detect the platform and falls back to
  // debian-openssl-1.1.x - while the distroless runtime needs 3.0.x, and
  // the engine it looks for is simply absent from the image.
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model TrackingEvent {
  id         String   @id @default(uuid())

  // Dedup key: Kafka is at-least-once.
  eventId    String   @unique

  shipmentId String
  reference  String
  eventType  String
  status     String
  driverId   String?
  // Copied from the event so reads can be authorised here, without asking
  // shipment-service who owns the shipment on every request.
  customerId   String?
  driverUserId String?
  origin     String
  destination String
  occurredAt DateTime
  recordedAt DateTime @default(now())

  @@index([shipmentId, occurredAt])
}

// A driver's position while on a job. Written by the driver's device (or the
// route simulator), read by the live map. Kept per shipment rather than per
// driver: the customer's question is "where is my parcel", and the trail
// should stop at delivery.
model LocationPing {
  id           String   @id @default(uuid())
  shipmentId   String
  driverUserId String
  lat          Float
  lng          Float
  heading      Float?
  speedKph     Float?
  accuracyM    Float?
  recordedAt   DateTime @default(now())

  @@index([shipmentId, recordedAt])
  @@index([recordedAt])
}

// Poison messages, parked so they cannot block a partition.
model DeadLetter {
  id        String   @id @default(uuid())
  eventId   String?
  topic     String
  partition Int
  offset    String
  payload   String
  error     String
  createdAt DateTime @default(now())
}
